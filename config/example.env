# Optional runtime location. Defaults to %LOCALAPPDATA%\IPCAM
IPCAM_DATA_DIR=C:\Users\YOUR_NAME\AppData\Local\IPCAM

# Optional standard Python executable override (Microsoft Store alias is not used)
IPCAM_PYTHON=C:\Users\YOUR_NAME\AppData\Local\Programs\Python\Python313\python.exe

# Optional explicit ffprobe executable
IPCAM_FFPROBE=C:\path\to\ffprobe.exe

# Local go2rtc API
IPCAM_GO2RTC_API=http://127.0.0.1:1984
